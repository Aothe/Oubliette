{
  "name": "oubliette-loop",
  "version": "0.1.0",
  "private": true,
  "description": "The loop prototype: one class, one dungeon, one boss on a deterministic fixed-point, fixed-tick simulation with an input log. SPEC §8 step 3.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "esbuild src/client.ts --bundle --format=iife --target=es2022 --outfile=dist/client.js --log-level=warning",
    "bench": "node --experimental-strip-types src/headless.ts bench",
    "fuzz": "node --experimental-strip-types src/headless.ts fuzz",
    "replay": "node --experimental-strip-types src/headless.ts replay"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
